@model IEnumerable<MEDICSALLOCATION_2.Models.ApplicationUser>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Manage pharmacists";
    var facilities = (IEnumerable<SelectListItem>)ViewBag.Facilities;
}

<h1 class="h2 mb-2">Manage pharmacist access</h1>
<p class="text-muted">Each pharmacist needs an assigned facility to open the stock pages.</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">There are no pharmacist accounts yet. <a asp-action="CreatePharmacist">Create a pharmacist account</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Pharmacist</th><th>Email</th><th>Assigned facility</th><th></th></tr></thead>
            <tbody>
            @foreach (var pharmacist in Model.OrderBy(p => p.FullName))
            {
                <tr>
                    <td>@(pharmacist.FullName ?? "Name not provided")</td>
                    <td>@pharmacist.Email</td>
                    <td>
                        <form asp-action="AssignPharmacistFacility" method="post" class="d-flex flex-wrap gap-2">
                            <input type="hidden" name="userId" value="@pharmacist.Id" />
                            <select name="facilityId" class="form-select" required aria-label="Facility for @pharmacist.Email">
                                <option value="">Choose a facility</option>
                                @foreach (var facility in facilities)
                                {
                                    <option value="@facility.Value" selected="@(facility.Value == pharmacist.FacilityId?.ToString())">@facility.Text</option>
                                }
                            </select>
                            <button class="btn btn-outline-primary">Save facility</button>
                        </form>
                    </td>
                    <td></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
