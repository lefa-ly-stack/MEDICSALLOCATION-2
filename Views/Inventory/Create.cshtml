@model MEDICSALLOCATION_2.Models.InventoryItem
@{
    ViewData["Title"] = "Add stock record";
}

<h2 class="mb-3">Add stock record</h2>
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="FacilityId" class="form-label">Facility</label>
        <select asp-for="FacilityId" asp-items="ViewBag.Facilities" class="form-select">
            <option value="">Choose a facility</option>
        </select>
        <span asp-validation-for="FacilityId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MedicineId" class="form-label">Medicine</label>
        <select asp-for="MedicineId" asp-items="ViewBag.Medicines" class="form-select">
            <option value="">Choose a medicine</option>
        </select>
        <span asp-validation-for="MedicineId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="QuantityOnHand" class="form-label">Quantity on hand</label>
        <input asp-for="QuantityOnHand" class="form-control" type="number" min="0" />
        <span asp-validation-for="QuantityOnHand" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="ReorderLevel" class="form-label">Reorder level</label>
        <input asp-for="ReorderLevel" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="MaxStockLevel" class="form-label">Maximum stock level</label>
        <input asp-for="MaxStockLevel" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="BatchNumber" class="form-label">Batch number</label>
        <input asp-for="BatchNumber" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="ExpiryDate" class="form-label">Expiry date</label>
        <input asp-for="ExpiryDate" class="form-control" type="date" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Save stock record</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
